# Copy to .env and fill in the secret. .env is git-ignored; never commit it.
OPENAI_API_KEY=

# Optional overrides (these are the defaults)
# OPENAI_BASE_URL=https://api.openai.com/v1
# PLANNER_MODEL=gpt-5.4-mini
# GUARD_MODEL=gpt-5.4-mini

# Optional failover provider, used when the primary returns an API error
ANTHROPIC_API_KEY=
# PRIMARY_PROVIDER=openai
# ANTHROPIC_PLANNER_MODEL=claude-sonnet-5
# ANTHROPIC_GUARD_MODEL=claude-haiku-4-5-20251001
LOGFIRE_TOKEN=

# Unity delivery (Phase G): the Unity project folder (containing Assets/) and the MCP endpoint
# The Unity project lives in ./unity-project (a relative path is taken from the repository root)
UNITY_PROJECT_PATH=unity-project
# UNITY_MCP_URL=http://127.0.0.1:8080/mcp
# Save each verified rig as a prefab in this folder of the Unity project (off when empty)
# UNITY_PREFAB_DIR=Assets/Prefabs/Rigs
